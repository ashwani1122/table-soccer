# Add these through the Clerk integration in Vercel to enable Google sign-in.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Public Cloudflare Worker URL, for example:
# https://flickxi-realtime.your-account.workers.dev/ws
NEXT_PUBLIC_REALTIME_URL=

# Legacy local/Vercel WebSocket fallback. Production does not need this after
# NEXT_PUBLIC_REALTIME_URL points to the Cloudflare Durable Object Worker.
REDIS_URL=
